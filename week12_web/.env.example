# Copy this file to a new file called .env and fill in your own values.
# .env is in .gitignore: it stays on your laptop. This example file holds no real secrets, so it can be shared.

# Your assistant's name (shown on the page).
ASSISTANT_NAME=Remy

# A long random secret that protects the admin routes (Lab 2: DELETE /api/memory/<key>;
# project: GET /api/stats). Make your own with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# and paste it after the = sign (no quotes, no spaces).
ADMIN_TOKEN=

# Day 4 project: the name shown on your app (change it to your own idea).
APP_NAME=Flashcard Maker
